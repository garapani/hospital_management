```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build outputs
dist/
build/
coverage/
.nyc_output/
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python specific (if applicable)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.envrc
.python-version

# TypeScript/JavaScript specific
*.tsbuildinfo
.next/
nuxt/dist/
public/dist/

# Testing
coverage/
.nyc_output/
.jest/
jest.config.js

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```