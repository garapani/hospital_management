{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.integration-spec.ts",
    "src/testing/**"
  ],
  "references": [
    {
      "path": "../../libs/pdf/tsconfig.lib.json"
    },
    {
      "path": "../../libs/object-storage/tsconfig.lib.json"
    },
    {
      "path": "../../libs/tenant-context/tsconfig.lib.json"
    },
    {
      "path": "../../libs/pagination/tsconfig.lib.json"
    },
    {
      "path": "../../libs/observability/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth-guards/tsconfig.lib.json"
    },
    {
      "path": "../../libs/audit-emitter/tsconfig.lib.json"
    }
  ]
}
