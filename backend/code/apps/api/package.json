{
  "name": "@org/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "api",
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/migrate.ts",
          "cwd": "apps/api"
        }
      },
      "migrate-tenants": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/migrate-tenants.ts",
          "cwd": "apps/api"
        }
      },
      "seed-rbac": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-rbac-catalog-runner.ts",
          "cwd": "apps/api"
        }
      },
      "seed-packages": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-packages-catalog-runner.ts",
          "cwd": "apps/api"
        }
      },
      "seed-ledger-accounts": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-ledger-accounts.ts",
          "cwd": "apps/api"
        }
      },
      "seed-initial-setup": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-initial-setup-runner.ts",
          "cwd": "apps/api"
        }
      },
      "seed-demo-data": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-demo-data-runner.ts",
          "cwd": "apps/api"
        }
      },
      "seed-demo-catalog": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-demo-catalog-runner.ts",
          "cwd": "apps/api"
        }
      },
      "seed-all": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/migrate.ts && SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-rbac-catalog-runner.ts && SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-packages-catalog-runner.ts && SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-initial-setup-runner.ts && SWC_NODE_PROJECT=../../tsconfig.base.json node --import @swc-node/register/esm-register src/database/seed-ledger-accounts.ts",
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@hospital/audit-emitter": "workspace:*",
    "@hospital/auth-guards": "workspace:*",
    "@hospital/excel": "workspace:*",
    "@hospital/object-storage": "workspace:*",
    "@hospital/observability": "workspace:*",
    "@hospital/pagination": "workspace:*",
    "@hospital/pdf": "workspace:*",
    "@hospital/tenant-context": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "exceljs": "4.4.0"
  }
}
